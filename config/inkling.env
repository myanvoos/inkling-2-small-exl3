# inkling-2-small-exl3: Inkling-2-Small (EXL3 2.59bpw) on the native TensorFold inkling2 server, TP=2 --
# rank 0 on the head node (127.0.0.1:8888), rank 1 on the worker (:8889) -- behind the inkling gateway on :8080.
# The source of truth for this stack's knobs: scripts/serve.sh sources it. Env-wins knobs have the ${X:-default}
# form and can be set for one start (CONTEXT=..., MIN_AVAIL_GIB=...).

# --- the two nodes (set these to your machines) ---
# 192.0.2.0/24 is the documentation range (RFC 5737); set these to your nodes.
HEAD_IP=${HEAD_IP:-192.0.2.11}              # the head node's address on the fast link (NCCL bootstrap + --master)
WORKER_SSH=${WORKER_SSH:-user@192.0.2.12}   # ssh target for the worker (passwordless, BatchMode)

# --- paths ---
# The repo root (this file lives in <repo>/config/). Override only if you keep config elsewhere.
DEPLOY=${DEPLOY:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}
# The engine binary. scripts/install_engine.sh builds engine/ and installs it here.
BIN=${BIN:-$HOME/.local/share/inkling-2-small-exl3/bin/tensorfold-native}
# Pin the binary's md5 to refuse a wrong/corrupt engine (empty = no check). The reference build of 2026-11-15
# (the reference build) is 5fdde316cb24bb8e912458b9c7723cc1.
ENGINE_MD5=${ENGINE_MD5:-}
# The model view (built by scripts/make_native_view.py): the EXL3 export's files + the dense-q6 pack + the native
# release, as symlinks. See docs/weights.md.
MODEL_VIEW=${MODEL_VIEW:-$HOME/models/inkling-2-small-exl3-view}
NATIVE_DIR=${NATIVE_DIR:-$MODEL_VIEW/native}   # the release's own NVFP4/MXFP8 weights, streamed by the mixed store
# sha256 of the view's checkpoint.json and of the dense pack's manifest.json. Empty = skip that check.
# The reference view (built 2026-11-15) has VIEW_SHA=97d75d66d3883514450772f8a3efb348467d35157925c908ea97315ae6e3feca
# and PACK_SHA=0c4b8774bdf088a93f1d69624725a80545b4a699249d40db6376b9a8f9089510.
VIEW_SHA=${VIEW_SHA:-}
PACK_SHA=${PACK_SHA:-}
# Template C (reasoning always on). The runner copies it to the worker.
CHAT_TEMPLATE=${CHAT_TEMPLATE:-$DEPLOY/config/chat_template.engine-C.jinja}
TEMPLATE_MD5=db5391e5c018eec0eaa718aaae664227
# NCCL. Leave NCCL_LIB empty to use the system libnccl (ldconfig); set it to a directory holding libnccl.so.2 otherwise.
NCCL_LIB=${NCCL_LIB:-}

# --- NCCL over RoCE (set to your fabric; for a single node or TCP, adjust or drop these) ---
NCCL_COMM_ID=${NCCL_COMM_ID:-$HEAD_IP:29597}
NCCL_SOCKET_IFNAME=${NCCL_SOCKET_IFNAME:-enp1s0f0np0}
NCCL_IB_HCA=${NCCL_IB_HCA:-rocep1s0f0,roceP2p1s0f0}
NCCL_IB_GID_INDEX=${NCCL_IB_GID_INDEX:-3}

# --- serving ---
PORT=${PORT:-8888}                 # rank 0's HTTP on loopback: the gateway's upstream
PEER_PORT=${PEER_PORT:-8889}       # rank 1's, on the worker's loopback
SERVED_NAME=inkling-2-small        # the engine's --name: the id the gateway lists
# The window: 500,000 positions. The server admits a request when prompt + max_tokens + 9 <= CONTEXT.
# Quality is validated to 8K (the export's needle panel); 500K is the serving target, not a validated length.
CONTEXT=${CONTEXT:-${MAX_MODEL_LEN:-500000}}
MAX_TOKENS=${MAX_TOKENS:-2048}     # the engine's reply cap when a request names none
# The engine's lanes (--parallel), for both ranks. inkling2's backend has ONE slot, but the server's default "auto"
# opens 8 lanes, so a second concurrent request was admitted into a lane the backend could not take and failed.
# With 1, the lane host queues it instead (foreground before background, arrival order).
PARALLEL=${PARALLEL:-1}
# MemAvailable floor per node (GiB). The engine's hard minimum; 2.3 caps use at ~120.9 GiB on a 123 GiB node.
TF_INKLING2_FLOOR_GIB=${TF_INKLING2_FLOOR_GIB:-2.3}
# The mixed store (default): every routed expert resident as EXL3 plus a native NVFP4/MXFP8 bank of hot experts
# streamed from the release (TF_INKLING2_MIX=1), the MXFP8 layers 40-47 at twice the NVFP4 layers' per-layer share.
# Set MIX_ENV= (empty) to boot the EXL3 store alone (bitwise the plain EXL3 path).
MIX_ENV=${MIX_ENV-TF_INKLING2_MIX=1 TF_INKLING2_MIX_NATIVE=$NATIVE_DIR TF_INKLING2_PRIOR=$DEPLOY/config/plan-gamma-scores.f32 TF_INKLING2_MIX_HISTORY=$DEPLOY/state/bank-history.bin TF_INKLING2_MIX_MX_PRIORITY=2}
# Conversation states on disk: a conversation's state survives the requests between its turns and server restarts.
ROWS_ENV=${ROWS_ENV-TF_INKLING2_ROWS_DIR=$DEPLOY/state/rows}
EXTRA_ENV=${EXTRA_ENV:-}           # more VAR=value pairs for both ranks (one start; experiments only)
# Open files, for both units (systemd-run -p LimitNOFILE). The EXL3 load opens every shard of the view at once
# (2,358 .safetensors); a user unit's default soft limit is 1024, so raise it.
NOFILE=${NOFILE:-500000}

# --- page caches ---
# The start drops the page cache on both nodes before the load and once more right after READY, with DROP_HELPER via
# sudo -n (root-owned, argument-less: sync; echo 3 > /proc/sys/vm/drop_caches). Where sudo -n refuses,
# scripts/drop_cache.py runs instead (the sudoless fadvise walk, ~25 s). While serving, a dropper unit on each node
# drops every DROP_EVERY_S when the node's reclaimable file cache exceeds DROP_MIN_MIB.
DROP_HELPER=${DROP_HELPER:-/usr/local/sbin/dropcache-helper}
DROP_EVERY_S=${DROP_EVERY_S:-30}
DROP_MIN_MIB=${DROP_MIN_MIB:-512}
DROP_UNIT=inkling-serve-dropcache
PEER_DROP_UNIT=inkling-serve-dropcache-r1

# --- the GPU pair lock ---
# A turnstile + gpu.lock pair in GPU_LOCK_DIR: a serve takes the turnstile, then the lock, and holds it for its
# whole lifetime, so no other GPU job starts beside it. On a shared machine, point this at the shared lock directory
# so this serve queues behind other GPU jobs instead of running beside them.
GPU_LOCK_DIR=${GPU_LOCK_DIR:-/var/tmp/inkling-gpu-lock}
LOCK_WAIT_S=${LOCK_WAIT_S:-1800}   # how long a start waits behind queued GPU jobs (0: no limit)
MIN_AVAIL_GIB=${MIN_AVAIL_GIB:-100}   # MemAvailable on both nodes after the cache drop (the load needs ~100)
READY_S=${READY_S:-1800}           # how long the load may take before the start gives up

# --- processes ---
UNIT=inkling-serve               # the head's systemd user unit: the serve, the lock holder and rank 0
PEER_UNIT=inkling-serve-r1       # the worker's: rank 1
LOGDIR=$DEPLOY/logs              # serve.log, r0-*.log here; r1-*.log on the worker (same path)

# --- the gateway (gateway/, built into the inkling-gateway:local image on first use) ---
GATEWAY_NAME=inkling-gateway
GATEWAY_PORT=8080
GATEWAY_MODEL=${GATEWAY_MODEL:-inkling-2-small}           # the served id (the engine's --name)
GATEWAY_DISPLAY_NAME=${GATEWAY_DISPLAY_NAME-Inkling-2-Small}
GATEWAY_ALIAS_MODEL=${GATEWAY_ALIAS_MODEL-}               # another listed id (none: one card)
# Answered, never listed (comma-separated): `inkling`, the name clients used before the served id became inkling-2-small.
GATEWAY_HIDDEN_ALIAS=${GATEWAY_HIDDEN_ALIAS-inkling}
GATEWAY_IMAGE=${GATEWAY_IMAGE:-inkling-gateway:local}
GATEWAY_ROOT=thinkingmachines/Inkling-2-Small-EXL3-Native
GATEWAY_MAX_TOKENS=65536
GATEWAY_FAMILY=inkling2            # the gateway's Inkling dialect: tool calls, reasoning levels, text-only card
# No GATEWAY_TEMPERATURE: an omitted temperature keeps the engine's default (greedy).
GATEWAY_ENV="-e GATEWAY_STABLE_TIME=1"
# The gateway's Inkling memory (each reply as the model wrote it) is written through to inkling-memory.jsonl in
# GATEWAY_STATE, mounted at /var/lib/inkling-gateway: a restart or a re-create keeps it.
GATEWAY_STATE=$DEPLOY/state/gateway
# Other gateway knobs go in GATEWAY_ENV (read at the gateway's start), e.g. -e GATEWAY_INKLING_PARALLEL=all to hand
# over every call the model made under parallel_tool_calls false (default stop: the reply ends after its first call
# message, so the engine's state holds the one call the client gets; drop: the first call only, no stop), or
# -e GATEWAY_INKLING_REPLAY_CHECK=0 to stop checking each reply's re-render against its tokens.
